# Secrets — never commit these.
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Local bot state (recreated from cloud backup on boot)
# The live database and anything derived from it — a refresh keeps a safety copy
# beside it, and neither belongs in the repository.
bot.db
bot.db.*
bot.db-wal
bot.db-shm
*.db-journal

# Logs & local noise
*.log
deploy_trigger.txt

# The static site built for GitHub Pages (scripts/build_site.py). Generated
# output: the pages come from templates/ and static/, so a committed copy would
# go stale the moment either changed, and a stale front door is indistinguishable
# from a deploy that never ran.
_site/

# The static site built for GitHub Pages — generated by scripts/build_site.py and
# published by .github/workflows/pages.yml. Never committed: it is a copy of
# templates/ and static/, and a committed copy is one that goes stale quietly.
_site/

# The hub built for its own host (scripts/build_hub.py). Generated the same way
# and for the same reason as _site/ above — the pages come from templates/hub/
# and hub/static/, so a committed copy is a copy that goes stale quietly, this
# time on the host that answers *what is the bot doing*.
_hub/

# The owner console built for its own host (scripts/build_owner.py).
_owner/

# The card preview built for looking at, not for shipping
# (scripts/preview_cards.py). Generated: it renders whatever the working tree
# currently builds, and a committed copy would be a screenshot of a past diff.
_preview/

# The console's build inputs. `static/console/` — the bundle itself — **is**
# committed, and it is the one deliberate exception to the rule recorded twice
# above. The host that serves the console is a Python runtime with no guaranteed
# Node, so a deploy that had to build it could fail to build it. The staleness
# that committing generated output normally risks is closed by
# `static/console/build.json`, a hash of these sources: `tests/test_console.py`
# recomputes it, so an edited-and-unrebuilt console fails the suite instead of
# shipping a bundle one commit behind.
console/node_modules/

# macOS / editors
.DS_Store
.idea/
.vscode/
.wrangler/
.agents/
Deleted/
.freebuff/
