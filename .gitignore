# Secrets — never commit these.
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Local bot state (recreated from cloud backup on boot)
# The live database and anything derived from it — a refresh keeps a safety copy
# beside it, and neither belongs in the repository.
bot.db
bot.db.*
bot.db-wal
bot.db-shm
*.db-journal

# Logs & local noise
*.log
deploy_trigger.txt
.freebuff/

# The static site built for GitHub Pages (scripts/build_site.py). Generated
# output: the pages come from templates/ and static/, so a committed copy would
# go stale the moment either changed, and a stale front door is indistinguishable
# from a deploy that never ran.
_site/

# The static site built for GitHub Pages — generated by scripts/build_site.py and
# published by .github/workflows/pages.yml. Never committed: it is a copy of
# templates/ and static/, and a committed copy is one that goes stale quietly.
_site/

# macOS / editors
.DS_Store
.idea/
.vscode/
