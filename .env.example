[TEMPLATE]
DISCORD_TOKEN=paste_your_bot_token_here
FLASK_SECRET_KEY=generate_a_long_random_string
ADMIN_PASSKEY=choose_a_strong_unique_passkey
DASHBOARD_BASE_URL=https://meow-discord-bot.onrender.com

# Cloud database backup (GitHub Gist). Both are required to enable auto-sync.
# Use a token with ONLY the "gist" scope and keep the Gist SECRET.
GITHUB_BACKUP_TOKEN=github_token_with_gist_scope
GIST_BACKUP_ID=id_of_your_private_gist

# Optional dedicated backup-encryption key. Backups are encrypted either way:
# when this is blank the bot derives the key from GITHUB_BACKUP_TOKEN, so the
# Gist holds nothing readable without that token and nobody has to remember to
# configure anything. Set this only if you want the key rotatable independently
# of the token. Generate one with:
#   python -c "from utils.cloud_sync import generate_key; print(generate_key())"
# WARNING: keep this key safe. If it ever changes, the bot still reads older
# snapshots (it holds both keys) but refuses to upload until the old ones can be
# read again, so the one good backup is never overwritten.
BACKUP_ENCRYPTION_KEY=

# How often a rotated timestamped snapshot is kept (seconds), and how many to
# retain. The always-current snapshot is written on every change; these control
# the point-in-time history you can roll back to.
BACKUP_SNAPSHOT_INTERVAL=1800
BACKUP_KEEP=5

# Which roles may use /market. This is a gate, not a permission: a member either
# holds one of these roles or is refused, and administrators are not an exception.
# Comma-separated for more than one role. Leave blank to use the compiled default
# (the role in utils/market.py DEFAULT_ACCESS_ROLE_IDS).
MARKET_ROLE_IDS=

# Optional: post unhandled command errors to a Discord webhook so failures are
# visible instead of being swallowed into stdout. Leave blank to disable.
ERROR_WEBHOOK_URL=

# Set to 1 only if you put the app behind your own reverse proxy (nginx, etc.)
# so login rate limiting can safely read X-Forwarded-For.
TRUST_PROXY_HEADERS=0

# Privileged intents. These stay OFF unless you set them to 1, because requesting
# an intent that isn't enabled in the Developer Portal makes Discord refuse the
# login entirely (the bot would go offline). To turn them on: Developer Portal ->
# your app -> Bot -> Privileged Gateway Intents, enable them there FIRST, then set
# the flags below. Message Content makes AutoMod link filtering and message-length
# XP work; Guild Members enables member join/leave events.
ENABLE_MESSAGE_CONTENT_INTENT=0
ENABLE_MEMBERS_INTENT=0
