[TEMPLATE]
[TEMPLATE]
DISCORD_TOKEN=paste_your_bot_token_here
FLASK_SECRET_KEY=generate_a_long_random_string
ADMIN_PASSKEY=choose_a_strong_unique_passkey
DASHBOARD_BASE_URL=https://meow-discord-bot.onrender.com

# Discord sign-in for the dashboard: the way a server's own administrators get
# in without being handed the operator's passkey or a one-time link. With these
# set, /login offers "Sign in with Discord"; the person sees only the servers
# where they hold Manage Server (or Administrator, or own it) AND the bot is
# already in, and the session can act on nothing else.
#
# Both halves come from the Developer Portal -> your app -> OAuth2. The client
# secret is a server-side credential: never put it in a page, a repository or
# Discord. Register this exact redirect URL on that same page, or Discord
# refuses every sign-in with a redirect_uri mismatch — the login page prints the
# URL to register for the host it is actually running on:
#
#   {DASHBOARD_BASE_URL}/login/discord/callback
#
# Leave both blank to switch the method off; the passkey and the one-time link
# keep working either way.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Which roles may use /market. This is a gate, not a permission: a member either
# holds one of these roles or is refused, and administrators are not an exception.
# Comma-separated for more than one role. Leave blank to use the compiled default
# (the role in utils/market.py DEFAULT_ACCESS_ROLE_IDS).
MARKET_ROLE_IDS=

# Optional: post unhandled command errors to a Discord webhook so failures are
# visible instead of being swallowed into stdout. Leave blank to disable.
ERROR_WEBHOOK_URL=

# The server the bot calls home — the one whose #update, #bot-error and #bug
# exist to receive what the bot has to say about itself. Used only as the
# fallback destination for a bug report: a report is posted in the server it was
# filed in whenever that server has a bug channel of its own, and lands here only
# when it does not, so a report is never silently dropped. Leave blank for the
# default server the bot's house channels were created in.
BOT_SERVER_GUILD_ID=

# Set to 1 only if you put the app behind your own reverse proxy (nginx, etc.)
# so login rate limiting can safely read X-Forwarded-For.
TRUST_PROXY_HEADERS=0

# Privileged intents. These stay OFF unless you set them to 1, because requesting
# an intent that isn't enabled in the Developer Portal makes Discord refuse the
# login entirely (the bot would go offline). To turn them on: Developer Portal ->
# your app -> Bot -> Privileged Gateway Intents, enable them there FIRST, then set
# the flags below. Message Content makes AutoMod link filtering and message-length
# XP work; Guild Members enables member join/leave events.
ENABLE_MESSAGE_CONTENT_INTENT=0
ENABLE_MEMBERS_INTENT=0

# Supabase Storage (database persistence). The bot uploads the live bot.db here
# roughly every 25 seconds, keeps the newest 5 hourly snapshots for point-in-time
# restore, and restores the newest usable one on boot. The bucket is private:
# every read and write needs this service-role key, and the payload is a raw
# SQLite file, so this key is the whole database's password. Keep it out of the
# dashboard and out of Discord, and rotate it if it ever leaks.
#
# (The older Gist backup and its at-rest encryption key are gone — Supabase
# replaced them, and nothing reads those variables any more.)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --------------------------------------------------------------------------- #
# Plans and licences
#
# Where the paid tiers are bought: a Lemon Squeezy **hosted checkout URL** per
# tier (product -> Share -> Copy link). It is public by nature — it is rendered
# into /pricing for anyone to click — and the variant id inside the path is what
# tells the store which product is being bought, so copy the link rather than
# building one by hand.
#
# Leave both blank and /pricing says "No billing yet" and keeps every button on
# the invite page, which is honest and is what a development deployment wants.
# With them set, the Pro and Enterprise cards link straight at the store, and the
# buyer receives a licence key they activate with /bot plan in their own server —
# one key covers as many servers as the plan allows, each taking one activation.
LEMONSQUEEZY_CHECKOUT_PRO=
LEMONSQUEEZY_CHECKOUT_ENTERPRISE=

# Optional, and only needed if a product is renamed in the store: these variant
# ids map a licence to a plan without reading the product's name. The ids are
# stable; the name is not. Both are found in the checkout URL (or the store API).
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_ENTERPRISE=

# Whether a licence is **required** for the paid systems. Off by default, and it
# starts off on purpose: switching it on takes Support Tickets, Economy & Casino,
# the Market, Starboard and the Activity Tracker away from every server that has
# not activated a licence — including servers using them today — and holds a free
# server to one server and no scheduled messages. Plans are recorded and shown
# either way; set this to 1 when the tiers should be real.
PLAN_ENFORCEMENT=0
