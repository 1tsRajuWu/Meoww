DISCORD_TOKEN=paste_your_bot_token_here
FLASK_SECRET_KEY=generate_a_long_random_string
ADMIN_PASSKEY=choose_a_strong_unique_passkey
DASHBOARD_BASE_URL=https://meow-discord-bot.onrender.com

# Cloud database backup (GitHub Gist). Both are required to enable auto-sync.
# Use a token with ONLY the "gist" scope and keep the Gist SECRET.
GITHUB_BACKUP_TOKEN=github_token_with_gist_scope
GIST_BACKUP_ID=id_of_your_private_gist

# Set to 1 only if you put the app behind your own reverse proxy (nginx, etc.)
# so login rate limiting can safely read X-Forwarded-For.
TRUST_PROXY_HEADERS=0
